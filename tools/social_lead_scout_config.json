    { "name": "Facebook", "site_filter": "site:facebook.com" },
    { "name": "Instagram", "site_filter": "site:instagram.com" },
    { "name": "Reddit", "site_filter": "site:reddit.com" },
    { "name": "Forum/Sonstige", "site_filter": "(site:gutefrage.net OR site:quora.com OR site:finanztip.de/forum OR site:wer-weiss-was.de)" }
  ],

  "phrase_templates": [
    "\"suche alternative zu\" {thema}",
